{
	"name": "enable-automatic-file-downloads",
	"version": "43.101.2",
	"description": "Enable automatic file downloads (no Save As prompt) via the manifest or via code, compared with the default prompt behavior.",
	"main": "index.js",
	"scripts": {
		"kill": "node ./scripts/kill.mjs",
		"client": "node ./scripts/launch.mjs",
		"client-code": "node ./scripts/launch.mjs http://localhost:5050/code.manifest.fin.json",
		"client-prompt": "node ./scripts/launch.mjs http://localhost:5050/prompt.manifest.fin.json",
		"build-client": "webpack build --config ./client/webpack.config.js --mode=development",
		"build": "npm run build-client",
		"start": "npx --yes http-server ./public -p 5050 -c-1",
		"setup": "cd ../../ && npm install && cd how-to/enable-automatic-file-downloads && npm run build"
	},
	"license": "SEE LICENSE IN LICENSE.MD",
	"devDependencies": {
		"@openfin/core": "43.101.2",
		"@openfin/node-adapter": "43.101.2",
		"ts-loader": "^9.5.1",
		"typescript": "^5.4.5",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	}
}
